{
  "name": "ai-assistant",
  "version": "2.0.5",
  "description": "Nexora Agent",
  "keywords": [
    "ai",
    "assistant",
    "openclaw",
    "gateway",
    "mcp",
    "computer-use",
    "wechat",
    "whatsapp",
    "agnes-ai"
  ],
  "author": "Nexora Agent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/2014-y/NexoraAgent"
  },
  "main": "main.js",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "node start-gateway.js",
    "test": "node scripts/run-guard-tests.js",
    "setup": "npm run install:deps && npm run init:config",
    "install:deps": "npm install -g openclaw@2026.9.1 open-computer-use@0.1.54",
    "init:config": "node -e \"const fs=require('fs');if(!fs.existsSync('openclaw.json'))fs.copyFileSync('config/openclaw.json.example','openclaw.json')\"",
    "doctor": "openclaw mcp doctor",
    "probe": "openclaw mcp probe",
    "logs": "node -e \"const fs=require('fs'),p=require('path');const d='logs';const f=fs.existsSync(d)?fs.readdirSync(d).filter(x=>x.startsWith('openclaw-')).sort():[];process.stdout.write(f.length?fs.readFileSync(p.join(d,f[f.length-1]),'utf8'):'no logs found');\"",
    "postinstall": "node scripts/patch-bundled-security-deps.js",
    "preapp:start": "node scripts/ensure-data-center-deps.js && node scripts/patch-bundled-security-deps.js",
    "app:start": "electron .",
    "preapp:dist": "node scripts/clean-dist.js && node scripts/ensure-asr-release-asset.js && node scripts/ensure-builtin-asr.js && node scripts/ensure-voice-release-asset.js && node scripts/pack-gateway-runtime.js && node scripts/prepare-acceleration-core.js && node patch_nsis.js && node scripts/ensure-data-center-deps.js",
    "clean:dist": "node scripts/clean-dist.js",
    "app:dist": "node scripts/run-electron-builder.js --windows nsis",
    "postapp:dist": "node scripts/copy-asr-to-dist.js && node scripts/copy-voice-to-dist.js && node scripts/verify-windows-package.js",
    "asr:ensure": "node scripts/ensure-asr-release-asset.js",
    "asr:copy-dist": "node scripts/copy-asr-to-dist.js",
    "voice:ensure": "node scripts/ensure-voice-release-asset.js",
    "voice:copy-dist": "node scripts/copy-voice-to-dist.js",
    "preapp:pack": "node scripts/prepare-dist.js",
    "app:pack": "electron-builder --dir",
    "dist:prepare": "node scripts/prepare-dist.js",
    "app:dist:mac": "npm run clean:dist && npm run dist:prepare && node scripts/run-electron-builder.js --mac --config config/electron-builder.mac.cjs && npm run verify:mac",
    "app:dist:linux": "npm run clean:dist && npm run dist:prepare && electron-builder --linux",
    "pack:runtime": "node scripts/pack-gateway-runtime.js",
    "verify:package": "node scripts/verify-windows-package.js",
    "data-center:install": "npm --prefix data-center install --omit=dev",
    "verify:mac": "node scripts/verify-mac-package.js"
  },
  "dependencies": {
    "@openclaw/feishu": "2026.9.1",
    "@openclaw/matrix": "2026.9.1",
    "@openclaw/slack": "2026.9.1",
    "@openclaw/voice-call": "2026.9.1",
    "@openclaw/whatsapp": "2026.9.1",
    "@tencent-connect/openclaw-qqbot": "2.0.3",
    "@tencent-weixin/openclaw-weixin": "2.4.8",
    "msedge-tts": "2.0.7",
    "node-pty": "^1.1.0",
    "open-computer-use": "0.1.54",
    "openclaw": "2026.9.1",
    "sherpa-onnx-node": "^1.13.4",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-darwin-arm64": "^1.13.4",
    "sherpa-onnx-darwin-x64": "^1.13.4",
    "sherpa-onnx-linux-arm64": "^1.13.4",
    "sherpa-onnx-linux-x64": "^1.13.4",
    "sherpa-onnx-win-x64": "^1.13.4"
  },
  "overrides": {
    "axios": "1.20.0",
    "protobufjs": "7.6.5",
    "qs": "6.16.0"
  },
  "devDependencies": {
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "unbzip2-stream": "1.4.3"
  },
  "build": {
    "appId": "com.2014y.aigateway",
    "productName": "Nexora Agent",
    "asar": true,
    "compression": "normal",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "forceCodeSigning": false,
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/sherpa-onnx-node/**",
      "**/node_modules/sherpa-onnx-win-x64/**",
      "**/node_modules/sherpa-onnx-darwin-arm64/**",
      "**/node_modules/sherpa-onnx-darwin-x64/**",
      "**/node_modules/sherpa-onnx-linux-x64/**",
      "**/node_modules/sherpa-onnx-linux-arm64/**",
      "**/data-center/**",
      "**/tts-worker.js",
      "**/*.node",
      "**/*.dll",
      "**/*.dylib",
      "**/*.so"
    ],
    "icon": "config/icon.ico",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "config/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "config/icon.png",
      "maintainer": "2014-y <yuan2014850884@gmail.com>",
      "category": "Utility"
    },
    "win": {
      "icon": "config/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexora Agent",
      "runAfterFinish": false,
      "include": "config/installer.nsh",
      "installerIcon": "config/icon.ico",
      "uninstallerIcon": "config/icon.ico",
      "deleteAppDataOnUninstall": true
    },
    "extraResources": [
      {
        "from": "build-resources/acceleration-core",
        "to": "acceleration-core"
      },
      {
        "from": "build-resources/gateway-runtime.tar",
        "to": "gateway-runtime.tar"
      },
      {
        "from": "builtin-asr",
        "to": "builtin-asr"
      },
      {
        "from": "release-assets/voice-packs",
        "to": "voice-packs"
      }
    ],
    "files": [
      "main.js",
      "client-settings-store.js",
      "google-login.js",
      "client_secret_*.json",
      "acceleration.js",
      "gateway-runtime.js",
      "home-resolve.js",
      "plugin-adapt.js",
      "openclaw-state.js",
      "gateway-auth.js",
      "openclaw-model-sync.js",
      "openclaw-plugin-registry.js",
      "openclaw-auth-sync.js",
      "openclaw-update-policy.js",
      "latency-tune.js",
      "channel-config-sanitize.js",
      "token-usage-parse.js",
      "plugin-catalog.js",
      "gateway-boot-harden.js",
      "role-config.js",
      "vision-model-config.js",
      "voice-runtime.js",
      "skill-center.js",
      "overflow-rollover-trigger.js",
      "tts-worker.js",
      "runtime-pack-manifest.js",
      "patch_gateway.js",
      "tool-turn-repair.js",
      "capture-desktop.ps1",
      "desktop-control.ps1",
      "weixin-direct-login.mjs",
      "preload.js",
      "renderer.js",
      "model-config-policy.js",
      "locales.js",
      "jsQR.js",
      "index.html",
      "index.css",
      "splash.html",
      "config/acceleration-core.json",
      "config/openclaw.json.example",
      "config/openclaw-templates/**/*",
      "config/icon.jpg",
      "config/icon.png",
      "config/icon.ico",
      "node_modules/node-pty/**/*",
      "node_modules/sherpa-onnx-node/**/*",
      "node_modules/sherpa-onnx-win-x64/**/*",
      "node_modules/sherpa-onnx-darwin-arm64/**/*",
      "node_modules/sherpa-onnx-darwin-x64/**/*",
      "node_modules/sherpa-onnx-linux-x64/**/*",
      "node_modules/sherpa-onnx-linux-arm64/**/*",
      "node_modules/msedge-tts/**/*",
      "node_modules/axios/**/*",
      "node_modules/isomorphic-ws/**/*",
      "node_modules/ws/**/*",
      "node_modules/xterm/**/*",
      "node_modules/xterm-addon-fit/**/*",
      "plugins/**/*",
      "hooks/auto-start-codex/**/*",
      "data-center/server.js",
      "data-center/package.json",
      "data-center/public/**/*",
      {
        "from": "data-center/node_modules",
        "to": "data-center/node_modules",
        "filter": [
          "**/*",
          "!ai-assistant/**/*",
          "!.staging/**/*",
          "!**/{test,tests,__tests__,docs,doc,example,examples,coverage,.github}/**",
          "!**/*.{md,markdown,map,ts,tsx}",
          "!**/LICENSE*",
          "!**/LICENCE*"
        ]
      },
      "media-cli/**/*",
      "extensions/media-http.js",
      "extensions/media-core-resolve.js",
      "extensions/media-core/**/*",
      "workspace/skills/image-generator/**/*",
      "workspace/skills/video-generator/**/*",
      "extensions/image-generator/**/*",
      "extensions/video-generator/**/*",
      "!node_modules/**/{test,tests,__tests__,docs,doc,example,examples,coverage,.github,man}/**",
      "!node_modules/**/*.{md,markdown,map,ts,tsx}",
      "!node_modules/**/LICENSE*",
      "!node_modules/**/LICENCE*",
      "!extensions/**/*",
      "extensions/image-generator/**/*",
      "extensions/video-generator/**/*",
      "extensions/media-core-resolve.js",
      "extensions/media-http.js",
      "extensions/media-core/**/*",
      "!.node-sandbox/**/*",
      "!build-resources/_acceleration-core-download/**/*",
      "!dist/**/*"
    ]
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "protobufjs@7.6.3": true,
    "tree-sitter-bash@0.25.1": true,
    "@google/genai@2.10.0": true
  }
}
