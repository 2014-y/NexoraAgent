# Node sandbox (contains full node installation, ~2GB)
# Users must run init.bat to set this up
.node-sandbox/

# OpenClaw workspace
.openclaw/
logs/
*.log

# Dependencies
node_modules/

# OS
.DS_Store
Thumbs.db
__pycache__/

/dist/
/build-resources/

# Scratch and runtime version files
/scratch/
.tmp*
.runtime-version

# Voice models (runtime downloads / local caches)
builtin-asr/
voice-packs/
*.tar.bz2
*.zip

# 发版 ASR 目录可进仓库；大压缩包默认忽略（约 220MB）
# 本地用 scripts/ensure-asr-release-asset.js 下载，打包后复制到 dist/
!release-assets/asr-models/
!release-assets/asr-models/**
release-assets/asr-models/*.tar.bz2
