{
  "id": "session-overflow-rollover",
  "name": "Session Overflow Rollover",
  "description": "上下文溢出、压缩失败或角色顺序冲突时：写入延续摘要到 MEMORY.md，归档旧会话并回投通讯渠道继续回答",
  "version": "1.2.0",
  "main": "index.js",
  "type": "module",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "是否启用溢出自动归档续聊"
      }
    }
  }
}
